# Als .env kopieren und Werte eintragen. Die .env niemals committen.

# FRED (Federal Reserve Bank of St. Louis)
FRED_API_KEY=

# SEC EDGAR verlangt eine Kennung mit Name und E-Mail
SEC_USER_AGENT="Vorname Nachname name@example.com"

# Interactive Brokers über das lokale IB Gateway
IB_HOST=127.0.0.1
# 4002 = IB Gateway Paper, 4001 = Live (gesperrt bis zur Go-Live-Freigabe)
IB_PORT=4002
IB_CLIENT_ID=1

# paper oder live; bis zur Freigabe nur paper
TRADING_MODE=paper

# Tiingo (Kurse nicht mehr gelisteter US-Aktien), kostenloser Account
TIINGO_API_KEY=

# Sicherung des Journals nach jedem Tageslauf (Ordner außerhalb des Repos, z.B. OneDrive)
JOURNAL_BACKUP_DIR=

# IBKR Flex Web Service (Trades), für Nachträge außerhalb des API-Zeitfensters (betrieb/nachtrag.py)
FLEX_TOKEN=
FLEX_QUERY_ID=
